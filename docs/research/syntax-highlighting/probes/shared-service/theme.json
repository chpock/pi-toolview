{
  "name": "research",
  "colors": { "editor.foreground": "#c6c8d1", "editor.background": "#202020" },
  "tokenColors": [
    { "scope": ["keyword", "storage"], "settings": { "foreground": "#c792ea" } },
    { "scope": ["variable"], "settings": { "foreground": "#82aaff" } },
    { "scope": ["variable.other.property", "entity.other.attribute-name"], "settings": { "foreground": "#ffcb6b" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#89ddff" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#f78c6c" } },
    { "scope": "string", "settings": { "foreground": "#c3e88d" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#f07178" } },
    { "scope": "comment", "settings": { "foreground": "#676e95" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#a9c8de" } },
    { "scope": ["constant.language", "constant.other"], "settings": { "foreground": "#ff5370" } }
  ]
}
